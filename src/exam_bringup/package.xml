<package format="2">
  <name>exam_bringup</name>
  <version>0.2.0</version>
  <description>ROS1 exam scene with TurtleBot3, A-star, DWA and RViz goals.</description>
  <maintainer email="organizer@example.com">Exam organizer</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>catkin</buildtool_depend>
  <exec_depend>rospy</exec_depend>
